---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
---

<BaseLayout 
  title="Schedule a Free 30-Minute Brand & Design Consultation | Tool" 
  description="Book a free consultation to discuss your needs. Design and software solutions for businesses in New York City and beyond."
  calBookingUrl="toolnyc/25-pete">

  <Header />
  <main class="py-16 px-4 flex justify-center" id="main-content">
    <div class="w-full max-w-3xl">
      <div class="site-grid py-8">
        <div class="col-start-0 col-span-6 md:col-start-4 md:col-span-8 lg:col-start-7 lg:col-span-12 text-center mb-4">
          <p class="text-body font-medium">Book a call</p>
          <p class="text-body text-caption-gray mt-1">Pick a time that works for you.</p>
        </div>
      </div>
      <div class="site-grid">
        <div class="col-span-6 lg:col-span-24" id="cal-inline" style="min-height: 80vh;"></div>
      </div>
      <div class="site-grid py-8">
        <p class="col-start-0 col-span-6 md:col-start-4 md:col-span-8 lg:col-start-7 lg:col-span-12 text-center text-body text-caption-gray">
          Prefer email? <a href="mailto:admin@tool.nyc" class="hover:text-neutral-900 transition-colors">admin@tool.nyc</a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
  <StickyBar />
</BaseLayout>

<script is:inline>
  (function() {
    var params = new URLSearchParams(window.location.search);
    var config = { layout: "month_view" };
    if (params.get("name")) config.name = params.get("name");
    if (params.get("email")) config.email = params.get("email");
    if (params.get("notes")) config.notes = params.get("notes");

    Cal("inline", {
      calLink: document.querySelector('meta[name="cal-booking-url"]')?.content || "toolnyc/25-pete",
      elementOrSelector: "#cal-inline",
      config: config,
    });
  })();
</script>
